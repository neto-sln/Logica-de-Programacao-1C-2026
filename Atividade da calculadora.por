programa {
  funcao inicio() {
    real n1
    real n2
    real soma
    real subtracao
    real multiplicacao
    real divisao
    // NOME DO ALUNO: Josimar Saraiva de Lima Neto
    // DATA DA ATIVIDADE: 09/09/2026
    // ESCOLA: EEEP Otília Correia Saraiva
    // SÉRIE: 1° C
    escreva ("Qual o número 1? ")
    leia (n1)
    escreva ("Qual o número 2? ")
    leia (n2)
    soma = n1 + n2
    subtracao = n1 - n2
    multiplicacao = n1 * n2
    divisao = n1 / n2
    escreva ("O resultado da soma dos dois números é: " ,soma , " .\n")
    escreva ("O resultado da subtração dos dois números é: " ,subtracao , " .\n")
    escreva ("O resultado da multiplicação dos dois números é: " ,multiplicacao , " .\n")  
    escreva ("O resultado da divisão dos dois números é: " ,divisao , " .\n")  

  }
}
