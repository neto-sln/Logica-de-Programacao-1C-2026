    //Objetivo	.....: Um algoritimo que pergunta até qual número o usuário quer verificar quais são pares, ele informa quais são os números pares e qual o resultado da soma de todos eles
    inteiro i, soma=0, quantidade
    escreva ("Quantos números vamos verificar? ")
    leia (quantidade)
    para (i = 1; i <= quantidade; i++){
        se (i % 2 == 0){
            escreva (i, "\n")
            soma = soma + i
        }
    }
    escreva ("Soma = ", soma, " ")
  }
}
